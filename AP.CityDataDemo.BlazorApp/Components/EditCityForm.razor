@using System.ComponentModel.DataAnnotations
@using AP.CityDataDemo.Shared.DTO
@inject HttpClient Http

<div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit City</h5>
                <button type="button" class="btn-close" @onclick="OnCancelClicked" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@editModel" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    @if (ValidationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in ValidationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <InputText class="form-control" @bind-Value="editModel.Name" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Population</label>
                        <InputNumber class="form-control" @bind-Value="editModel.Population" />
                        <ValidationMessage For="@(() => editModel.Population)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Country</label>
                        <InputSelect class="form-select" @bind-Value="editModel.CountryId">
                            @if (Countries != null)
                            {
                                foreach (var country in Countries)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => editModel.CountryId)" />
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="OnCancelClicked">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public CityDto Model { get; set; } = new();
    [Parameter] public IEnumerable<CountryDto>? Countries { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private CityDto editModel = new();
    public List<string> ValidationErrors { get; set; } = new();
    private bool isSubmitting = false;

    protected override void OnParametersSet()
    {
        // clone into a local model so changes don't affect the parent until saved
        editModel = new CityDto
        {
            Id = Model.Id,
            Name = Model.Name,
            Population = Model.Population,
            CountryId = Model.CountryId,
            CountryName = Model.CountryName
        };
    }

    private async Task HandleValidSubmit()
    {
        ValidationErrors.Clear();
        isSubmitting = true;
        try
        {
            var payload = new
            {
                Id = editModel.Id,
                Name = editModel.Name,
                Population = editModel.Population,
                CountryId = editModel.CountryId
            };

            var response = await Http.PutAsJsonAsync($"api/v1/city/{editModel.Id}", payload);
            if (response.IsSuccessStatusCode)
            {
                await OnSaved.InvokeAsync();
                return;
            }
            if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var content = await response.Content.ReadAsStringAsync();
                try
                {
                    var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string[]>>(content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (dict != null)
                    {
                        ValidationErrors = dict.SelectMany(kv => kv.Value).ToList();
                    }
                    else
                    {
                        var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(content);
                        ValidationErrors = list ?? new List<string> { content };
                    }
                }
                catch
                {
                    ValidationErrors = new List<string> { content };
                }
                return;
            }
            ValidationErrors = new List<string> { "Sorry, we could not update the city at this time." };
        }
        catch
        {
            ValidationErrors = new List<string> { "Sorry, we could not update the city at this time." };
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OnCancelClicked()
    {
        await OnCancel.InvokeAsync();
    }
}


