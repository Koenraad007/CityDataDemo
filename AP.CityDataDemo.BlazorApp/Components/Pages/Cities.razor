@page "/cities"
@using AP.CityDataDemo.Shared.DTO
@using System.Net.Http.Json

@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Cities</PageTitle>

<h1>Cities Overview</h1>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="mb-3">
            <button class="btn btn-primary me-2" @onclick="() => SortByPopulation(false)">
                Sort by Population (Low → High)
            </button>
            <button class="btn btn-primary" @onclick="() => SortByPopulation(true)">
                Sort by Population (High → Low)
            </button>
        </div>
    </div>
    <div class="col-md-6">
        <button class="btn btn-success" @onclick="ToggleAddForm">
            @if (showAddForm)
            {
                <span>➖ Hide Form</span>
            }
            else
            {
                <span>➕ Add City</span>
            }
        </button>
    </div>
</div>

@if (showAddForm)
{
    <div class="row mb-4">
        <div class="col-md-8">
            <AddCityForm OnCityAdded="OnCityAdded" />
        </div>
    </div>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (cities == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>City</th>
                <th>Country</th>
                <th>Population</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var city in cities)
            {
                <tr>
                    <td>@city.Name</td>
                    <td>@city.CountryName</td>
                    <td>@city.Population.ToString("N0")</td>
                    <td>
                        <button class="btn btn-sm btn-warning me-2" @onclick="() => ShowEditPopup(city)">
                            Edit
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteCity(city.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* Modal for editing city *@
@if (IsEditPopupVisible && SelectedCity != null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit City</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditPopup" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @* Show errors here *@
                    @if (ValidationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in ValidationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="SelectedCity.Name" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Population</label>
                        <input type="number" class="form-control" @bind="SelectedCity.Population" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Country</label>
                        <select class="form-select" @bind="SelectedCity.CountryId" required>
                            @if (CountriesList != null)
                            {
                                foreach (var country in CountriesList)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseEditPopup">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveEdit">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public IEnumerable<CountryDto> CountriesList { get; set; } = new List<CountryDto>();
    public List<string> ValidationErrors { get; set; } = new();
    private IEnumerable<CityDto>? cities;
    private string? errorMessage;
    private bool showAddForm = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load cities and countries from API
            cities = await Http.GetFromJsonAsync<List<CityDto>>("http://localhost:5265/api/v1/city");
            CountriesList = await Http.GetFromJsonAsync<List<CountryDto>>("http://localhost:5265/api/v1/country") ?? new List<CountryDto>();
        }
        catch (Exception)
        {
            errorMessage = "Sorry, we could not load the city data at this time.";
        }
    }

    private async Task SortByPopulation(bool descending)
    {
        try
        {
            // Call API with query parameters to request sorted data
            var uri = $"http://localhost:5265/api/v1/city?orderBy=population&asc={!descending}";
            cities = await Http.GetFromJsonAsync<List<CityDto>>(uri);
            errorMessage = null;
        }
        catch (Exception)
        {
            errorMessage = "Sorry, we could not sort the city data at this time.";
        }
    }

    private void ToggleAddForm()
    {
        showAddForm = !showAddForm;
    }

    private async Task OnCityAdded()
    {
        showAddForm = false;
        await LoadCities();
    }

    private async Task LoadCities()
    {
        try
        {
            cities = await Http.GetFromJsonAsync<List<CityDto>>("http://localhost:5265/api/v1/city");
            errorMessage = null;
        }
        catch (Exception)
        {
            errorMessage = "Sorry, we could not load the city data at this time.";
        }
    }

    public bool IsEditPopupVisible { get; set; } = false;

    public CityDto? SelectedCity { get; set; }
    public void ShowEditPopup(CityDto city)
    {
        SelectedCity = new CityDto
        {
            Id = city.Id,
            Name = city.Name,
            Population = city.Population,
            CountryId = city.CountryId != 0 ? city.CountryId : (CountriesList.FirstOrDefault()?.Id ?? 0),
            CountryName = city.CountryName
        };
        IsEditPopupVisible = true;
    }

    public void CloseEditPopup()
    {
        IsEditPopupVisible = false;
        SelectedCity = null;
    }

    public async Task SaveEdit()
    {
        ValidationErrors.Clear();
        if (SelectedCity != null && SelectedCity.CountryId != 0)
        {
            var payload = new
            {
                Id = SelectedCity.Id,
                Name = SelectedCity.Name,
                Population = SelectedCity.Population,
                CountryId = SelectedCity.CountryId
            };

            try
            {
                var response = await Http.PutAsJsonAsync($"http://localhost:5265/api/v1/city/{SelectedCity.Id}", payload);
                if (response.IsSuccessStatusCode)
                {
                    IsEditPopupVisible = false;
                    SelectedCity = null;
                    cities = await Http.GetFromJsonAsync<List<CityDto>>("http://localhost:5265/api/v1/city");
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    // Try to parse validation errors returned by the API
                    var content = await response.Content.ReadAsStringAsync();
                    try
                    {
                        var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string[]>>(content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (dict != null)
                        {
                            ValidationErrors = dict.SelectMany(kv => kv.Value).ToList();
                        }
                        else
                        {
                            var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(content);
                            ValidationErrors = list ?? new List<string> { content };
                        }
                    }
                    catch
                    {
                        ValidationErrors = new List<string> { content };
                    }
                }
                else
                {
                    errorMessage = "Sorry, we could not update the city at this time.";
                }
            }
            catch (Exception)
            {
                errorMessage = "Sorry, we could not update the city at this time.";
            }
        }
    }

    public async Task DeleteCity(int cityId)
    {
        if (cityId != 0)
        {
            var city = cities?.FirstOrDefault(c => c.Id == cityId);
            try
            {
                var response = await Http.DeleteAsync($"http://localhost:5265/api/v1/city/{cityId}");
                if (response.IsSuccessStatusCode)
                {
                    cities = await Http.GetFromJsonAsync<List<CityDto>>("http://localhost:5265/api/v1/city");
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    var content = await response.Content.ReadAsStringAsync();
                    try
                    {
                        var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string[]>>(content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (dict != null)
                        {
                            errorMessage = string.Join("; ", dict.SelectMany(kv => kv.Value));
                        }
                        else
                        {
                            var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(content);
                            errorMessage = list != null ? string.Join("; ", list) : content;
                        }
                    }
                    catch
                    {
                        errorMessage = content;
                    }
                }
                else
                {
                    errorMessage = "Sorry, we could not delete the city at this time.";
                }
            }
            catch (Exception)
            {
                errorMessage = "Sorry, we could not delete the city at this time.";
            }
        }
    }
}
